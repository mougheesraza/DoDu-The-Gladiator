# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY="MY_GEMINI_API_KEY"

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# ===================================================
# PHASE 2 SOCIAL MEDIA API INTEGRATIONS (OPTIONAL IN PHASE 1)
# ===================================================

# YouTube Data API v3 (for channel uploads, video stats & playlists)
YOUTUBE_API_KEY=""
YOUTUBE_CHANNEL_ID=""

# TikTok Display API (for user profile & video posts)
TIKTOK_CLIENT_KEY=""
TIKTOK_CLIENT_SECRET=""
TIKTOK_ACCESS_TOKEN=""

# Instagram Graph API / Display API (for media feeds & reels)
INSTAGRAM_ACCESS_TOKEN=""
INSTAGRAM_USER_ID=""

# Facebook Meta Graph API (for Page posts & Profile feeds)
FACEBOOK_PAGE_ACCESS_TOKEN=""
FACEBOOK_PAGE_ID=""
FACEBOOK_USER_ACCESS_TOKEN=""

# X / Twitter API v2 (for tweets, retweets & analytics)
TWITTER_BEARER_TOKEN=""
TWITTER_API_KEY=""
TWITTER_API_SECRET=""

# Database Integration (Supabase / PostgreSQL ready)
SUPABASE_URL=""
SUPABASE_ANON_KEY=""
DATABASE_URL=""

# Admin & Portal Security
ADMIN_SECRET_KEY=""

